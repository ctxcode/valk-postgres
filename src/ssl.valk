use valk.net

/// SSL settings for `connect_with`.
+ class SslOptions {
    /// How SSL is used. The default verifies the server certificate and its host name.
    + mode: SslMode (SslMode.verify_full)
    /// A PEM file with CA certificates to trust besides the system store, for a server
    /// certificate from a private CA. Only checked in `verify_full` mode.
    + ca_file: ?String (null)
    /// A PEM file with the client certificate, optionally followed by the intermediate
    /// certificates, sent when the server asks for one (`clientcert` in `pg_hba.conf`).
    + certificate_file: ?String (null)
    /// The PEM private key of `certificate_file`. Null reads it from `certificate_file`.
    + private_key_file: ?String (null)
    /// The password of an encrypted private key.
    + key_password: String ("")
}

extend Connection {
    fn enable_ssl() !Error {
        // SSLRequest
        let s = this.sender
        s.write_u32_be(SSL_REQUEST_CODE)
        this.write_message_untyped()
        this.send() !>
        // The server answers with a single byte: 'S' (proceed) or 'N' (no SSL)
        let buf = this.recv_scratch.view(0, 1)
        this.con.read(buf) ! throw .connect { message: "Failed to read the SSL response from the server" }
        let answer = buf[0]
        if answer == 'N' {
            if this.ssl.mode == SslMode.require || this.ssl.mode == SslMode.verify_full : throw .ssl { message: "The server does not support SSL" }
            return
        }
        if answer != 'S' : throw .protocol { message: "Invalid SSL response from the server" }

        let options = this.ssl
        let ssl = net.Ssl.new()
        ssl.set_verify(options.mode == SslMode.verify_full)
        let ca_file = options.ca_file
        if isset(ca_file) : ssl.set_ca_cert(ca_file) ! throw .ssl { message: "Cannot read the CA file '" + ca_file + "'" }
        let certificate = options.certificate_file
        if isset(certificate) {
            let key_file = options.private_key_file
            let key = isset(key_file) ? key_file : certificate
            ssl.set_certificate(certificate, key, options.key_password) ! {
                throw .ssl { message: "Cannot use the client certificate '" + certificate + "' with the key '" + key + "'" }
            }
        }
        this.con.ssl_connect(ssl) ! throw .ssl { message: "Failed to establish SSL connection: " + ssl.get_error_message() }
        this.ssl_active = true
    }
}
