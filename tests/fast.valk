use postgres

test "Fast row api" {
    let con = connect() ! {
        println(E.message)
        assert(false)
        return
    }
    defer con.close()

    con.query("DROP TABLE IF EXISTS fast_t; CREATE TABLE fast_t (id serial PRIMARY KEY, name text, score float8, ok bool)") ! { println(E.message) assert(false) return }
    con.query("INSERT INTO fast_t (name, score, ok) VALUES ('a', 1.5, true), ('b', -2, false), (NULL, NULL, NULL)") ! { println(E.message) assert(false) return }
    assert(con.affected_rows == 3)

    con.query("SELECT id, name, score, ok FROM fast_t ORDER BY id") ! { println(E.message) assert(false) return }
    assert(con.col_count() == 4)
    assert(con.col_name(1) == "name")
    assert(con.col_name(9) == "")
    let name_col = con.col_index("name") ! { assert(false) return }
    assert(name_col == 1)
    assert(con.col_type(0) == 23)
    assert((con.col_index("nope") !? 999) == 999)

    let rows = 0
    while con.next_row() ! { println(E.message) assert(false) return } {
        rows++
        if rows == 1 {
            assert(con.col_int(0) == 1)
            assert(con.col_string(name_col) == "a")
            assert(con.col_view(name_col).equals("a"))
            assert(con.col_float(2) == 1.5)
            assert(con.col_bool(3))
            assert(!con.col_is_null(1))
            assert(con.col_value(2).type == postgres.TYPE.float)
            assert(con.col_value(0).to_int() == 1)
        } else if rows == 2 {
            assert(con.col_int(0) == 2)
            assert(con.col_string(1) == "b")
            assert(con.col_float(2) == -2)
            assert(!con.col_bool(3))
        } else {
            assert(con.col_int(0) == 3)
            assert(con.col_is_null(1))
            assert(con.col_is_null(2))
            assert(con.col_is_null(3))
            assert(con.col_string(1) == "")
            assert(con.col_int(2) == 0)
            assert(con.col_view(1).length == 0)
            assert(con.col_value(1).is_null())
            // Out of range columns
            assert(con.col_is_null(10))
            assert(con.col_string(10) == "")
        }
    }
    assert(rows == 3)
    assert(con.affected_rows == 3)
    assert(!con.next_row() ! { assert(false) return })

    // Mixing with fetch_row and continuing into the next statement
    con.query("SELECT id FROM fast_t ORDER BY id; SELECT name FROM fast_t WHERE id = 2") ! { println(E.message) assert(false) return }
    assert(con.next_row() ! { assert(false) return })
    assert(con.col_int(0) == 1)
    let row: Map[postgres.Value] = .{}
    assert(con.fetch_row(row) ! { assert(false) return })
    assert((row["id"] ?? 0).to_int() == 2)
    assert(con.next_row() ! { assert(false) return })
    assert(con.col_int(0) == 3)
    assert(con.next_row() ! { assert(false) return })
    assert(con.col_name(0) == "name")
    assert(con.col_string(0) == "b")
    assert(!con.next_row() ! { assert(false) return })

    // Parameters + a large result
    con.query("SELECT n, 'x' || n AS s FROM generate_series(1, :n::int) AS n", .{ "n" => 5000 }) ! { println(E.message) assert(false) return }
    let sum = 0
    let len = 0
    while con.next_row() ! { assert(false) return } {
        sum += con.col_int(0)
        len += con.col_view(1).length
    }
    assert(sum == 12502500)
    assert(len == 5000 + 9 + 180 + 2700 + 4 * 4001)
    assert(con.affected_rows == 5000)

    // Error while reading rows
    con.query("SELECT 10 / (5 - n) FROM generate_series(1, 10) AS n") ! { println(E.message) assert(false) return }
    let failed = false
    rows = 0
    while true {
        let more = con.next_row() ! {
            failed = true
            assert(E.sqlstate == "22012")
            break
        }
        if !more : break
        rows++
    }
    assert(failed)
    assert(rows == 4)
    con.query("SELECT 1 AS v") ! { println(E.message) assert(false) return }
    assert(con.next_row() ! { assert(false) return })
    assert(con.col_int(0) == 1)
}
