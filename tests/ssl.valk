use postgres

fn ssl_fails(port: u32, mode: postgres.SslMode) bool {
    let con = connect(port, mode) ! {
        return error_is(E.code, ssl)
    }
    con.close()
    return false
}

test "SSL" {
    // The md5 server has no SSL configured
    let plain = connect(5433, postgres.SslMode.disable) ! { println(E.message) assert(false) return }
    assert(!plain.ssl_enabled())
    plain.close()
    let preferred = connect(5433, postgres.SslMode.prefer) ! { println(E.message) assert(false) return }
    assert(!preferred.ssl_enabled())
    preferred.close()
    assert(ssl_fails(5433, postgres.SslMode.require))
    assert(ssl_fails(5433, postgres.SslMode.verify_full))

    // The SSL server has a self-signed certificate
    let secure = connect(5434, postgres.SslMode.require) ! { println("SSL: " + E.message) assert(false) return }
    defer secure.close()
    assert(secure.ssl_enabled())
    secure.query("SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()") ! { println(E.message) assert(false) return }
    let row = secure.fetch_one() ! { assert(false) return }
    assert(isset(row))
    if isset(row) : assert((row["ssl"] ?? false).to_bool())
    // Larger transfers over SSL
    secure.query("SELECT repeat('x', 200000) AS t") ! { println(E.message) assert(false) return }
    row = secure.fetch_one() ! { assert(false) return }
    assert(isset(row))
    if isset(row) : assert((row["t"] ?? "").to_string().length == 200000)
    secure.query("SELECT :v::int AS v", .{ "v" => 3 }) ! { println(E.message) assert(false) return }
    row = secure.fetch_one() ! { assert(false) return }
    assert(isset(row))
    if isset(row) : assert((row["v"] ?? 0).to_int() == 3)

    let preferred_ssl = connect(5434, postgres.SslMode.prefer) ! { println(E.message) assert(false) return }
    assert(preferred_ssl.ssl_enabled())
    preferred_ssl.close()
    assert(ssl_fails(5434, postgres.SslMode.verify_full))
}

// Files tests/servers.sh made for the server on 5435, which asks for a client certificate
fn test_cert(name: String) String {
    return __DIR__ + "/certs/" + name
}
fn connect_mtls(options: postgres.SslOptions) postgres.Connection !postgres.Error {
    let con = postgres.connect_with("127.0.0.1", "test", "root", "valk_postgres_tests", 5435, options) !>
    return con
}
fn mtls_fails(options: postgres.SslOptions) bool {
    let con = connect_mtls(options) ! return error_is(E.code, ssl)
    con.close()
    return false
}
fn client_dn(con: postgres.Connection) String {
    con.query("SELECT client_dn FROM pg_stat_ssl WHERE pid = pg_backend_pid()") ! return ""
    let row = con.fetch_one() ! return ""
    if !isset(row) : return ""
    return (row["client_dn"] ?? "").to_string()
}

test "SSL client certificate" {
    // Without a certificate the server refuses the login
    let anonymous = connect_mtls(postgres.SslOptions { ca_file: test_cert("ca.crt") }) ! {
        assert(error_is(E.code, auth))
        return
    }
    anonymous.close()
    assert(false)

    // With one, and the server certificate checked against the test CA
    let con = connect_mtls(postgres.SslOptions {
        ca_file: test_cert("ca.crt")
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("client.key")
    }) ! { println(E.message) assert(false) return }
    assert(con.ssl_enabled())
    assert(client_dn(con) == "/CN=test")
    con.close()

    // An encrypted key with its password
    let encrypted = connect_mtls(postgres.SslOptions {
        ca_file: test_cert("ca.crt")
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("client-encrypted.key")
        key_password: "secret"
    }) ! { println(E.message) assert(false) return }
    assert(client_dn(encrypted) == "/CN=test")
    encrypted.close()

    // Without verification the CA file is not needed
    let unverified = connect_mtls(postgres.SslOptions {
        mode: postgres.SslMode.require
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("client.key")
    }) ! { println(E.message) assert(false) return }
    assert(client_dn(unverified) == "/CN=test")
    unverified.close()
}

test "SSL client certificate errors" {
    // A wrong password, and a key that belongs to another certificate
    assert(mtls_fails(postgres.SslOptions {
        ca_file: test_cert("ca.crt")
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("client-encrypted.key")
        key_password: "wrong"
    }))
    assert(mtls_fails(postgres.SslOptions {
        ca_file: test_cert("ca.crt")
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("server.key")
    }))
    // The system store alone does not cover the test CA
    assert(mtls_fails(postgres.SslOptions {
        certificate_file: test_cert("client.crt")
        private_key_file: test_cert("client.key")
    }))
}
